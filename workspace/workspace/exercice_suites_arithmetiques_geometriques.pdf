\begin{center}
  {\LARGE \textbf{Exercice : Suites géométriques et arithmétiques}}\\[0.5em]
  {\large Terminale Spécialité Mathématiques}
\end{center}

% ---------------------- EXERCICE 1 ----------------------
\exo{1}{Étude de suites, monotonie et convergence}

\partie{Partie A -- Suite arithmético-géométrique et convergence}

On considère la suite $(u_n)$ définie par son premier terme $u_0 = 1$ et, pour tout entier naturel $n$, par la relation de récurrence :
$$u_{n+1} = \frac{1}{2}u_n + 3$$

\begin{enumerate}
  \item Calculer les termes $u_1$ et $u_2$.
  \item Démontrer par récurrence que pour tout entier naturel $n$, on a : $u_n < 6$.
  \item Étudier la monotonie de la suite $(u_n)$. En déduire qu'elle converge.
  \item On définit la suite $(v_n)$ pour tout entier naturel $n$ par : $v_n = u_n - 6$.
  \begin{enumerate}
    \item Démontrer que $(v_n)$ est une suite géométrique dont on précisera la raison et le premier terme $v_0$.
    \item Exprimer $v_n$ puis $u_n$ en fonction de $n$.
    \item Déterminer la limite de la suite $(u_n)$ lorsque $n$ tend vers $+\infty$.
  \end{enumerate}
\end{enumerate}

\partie{Partie B -- Comparaison avec une suite arithmétique}

On considère une suite arithmétique $(w_n)$ de premier terme $w_0 = 2$ et de raison $r = 1,5$.
\begin{enumerate}
  \item Exprimer $w_n$ en fonction de $n$.
  \item À partir de quel rang $n_0$ a-t-on $w_n > u_n$ ?
\end{enumerate}

\vspace{1.5em}
\hrule height 0.5pt
\vspace{1em}
\noindent{\large\textbf{Corrigé détaillé}}

\partie{Partie A}

\begin{enumerate}
  \item \textbf{Calcul des premiers termes :}
  \begin{itemize}
    \item $u_1 = \frac{1}{2}u_0 + 3 = \frac{1}{2}(1) + 3 = 3,5$
    \item $u_2 = \frac{1}{2}u_1 + 3 = \frac{1}{2}(3,5) + 3 = 4,75$
  \end{itemize}

  \item \textbf{Démonstration par récurrence :}
  \begin{itemize}
    \item \textit{Initialisation :} Pour $n = 0$, $u_0 = 1$ et $1 < 6$, donc la propriété est vraie au rang $0$.
    \item \textit{Hérédité :} Soit $n \in \mathbb{N}$ fixé. Supposons que $u_n < 6$. Montrons que $u_{n+1} < 6$.
    Par hypothèse de récurrence :
    $$u_n < 6 \implies \frac{1}{2}u_n < 3 \implies \frac{1}{2}u_n + 3 < 6 \implies u_{n+1} < 6$$
    La propriété est donc héréditaire.
  \end{itemize}
  \textit{Conclusion :} Pour tout entier naturel $n$, $u_n < 6$.

  \item \textbf{Monotonie et convergence :}
  Calculons la différence $u_{n+1} - u_n$ :
  $$u_{n+1} - u_n = \frac{1}{2}u_n + 3 - u_n = 3 - \frac{1}{2}u_n = \frac{6 - u_n}{2}$$
  Or, pour tout $n$, $u_n < 6$, donc $6 - u_n > 0$. Par conséquent, $u_{n+1} - u_n > 0$, ce qui signifie que \textbf{la suite $(u_n)$ est strictement croissante}.
  Étant strictement croissante et majorée par $6$, le théorème de la convergence monotone garantit que \textbf{la suite $(u_n)$ converge}.

  \item \textbf{Suite auxiliaire géométrique :}
  \begin{enumerate}
    \item Pour tout entier naturel $n$ :
    $$v_{n+1} = u_{n+1} - 6 = \left(\frac{1}{2}u_n + 3\right) - 6 = \frac{1}{2}u_n - 3 = \frac{1}{2}(u_n - 6) = \frac{1}{2}v_n$$
    La suite $(v_n)$ est donc \textbf{géométrique de raison $q = \frac{1}{2}$} et de premier terme $v_0 = u_0 - 6 = 1 - 6 = -5$.
    
    \item Exprimons $v_n$ puis $u_n$ :
    $$v_n = v_0 \times q^n = -5 \left(\frac{1}{2}\right)^n$$
    Puisque $v_n = u_n - 6$, on en déduit :
    $$u_n = v_n + 6 = 6 - 5 \left(\frac{1}{2}\right)^n$$
    
    \item Limite de $(u_n)$ :
    Comme $-1 < \frac{1}{2} < 1$, on a $\lim_{n \to +\infty} \left(\frac{1}{2}\right)^n = 0$. Par opérations sur les limites :
    $$\lim_{n \to +\infty} u_n = 6 - 5 \times 0 = 6$$
  \end{enumerate}
\end{enumerate}

\partie{Partie B}

\begin{enumerate}
  \item \textbf{Expression de la suite arithmétique $(w_n)$ :}
  Puisque $(w_n)$ est arithmétique de premier terme $w_0 = 2$ et de raison $r = 1,5$, on a :
  $$w_n = w_0 + n \times r = 2 + 1,5n$$

  \item \textbf{Recherche du rang $n_0$ :}
  Résolvons l'inéquation $w_n > u_n$ :
  $$2 + 1,5n > 6 - 5 \left(\frac{1}{2}\right)^n$$
  Testons les premières valeurs de $n$ :
  \begin{itemize}
    \item Pour $n = 0$ : $w_0 = 2$ et $u_0 = 1$ ($2 > 1$).
    \item Pour $n = 1$ : $w_1 = 3,5$ et $u_1 = 3,5$ ($3,5 \ngtr 3,5$).
    \item Pour $n = 2$ : $w_2 = 5$ et $u_2 = 4,75$ ($5 > 4,75$).
  \end{itemize}
  Le plus petit entier naturel $n_0$ pour lequel $w_n > u_n$ est donc \textbf{$n_0 = 2$}.
\end{enumerate}

